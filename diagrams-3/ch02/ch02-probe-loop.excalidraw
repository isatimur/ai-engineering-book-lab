  },
  {
   "type": "text",
   "id": "t12",
   "x": 80,
   "y": 330,
   "text": "Fails when the product rests on capabilities whose limits nobody knows yet.",
   "fontSize": 15,
   "fontFamily": 2,
   "strokeColor": "#b42318"
  },
  {
   "type": "text",
   "id": "t13",
   "x": 80,
   "y": 385,
   "text": "FINDING INTENT BY BUILDING",
