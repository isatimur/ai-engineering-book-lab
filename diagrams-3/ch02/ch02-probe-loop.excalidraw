   "text": "BOOK 3 · CHAPTER 2 · HOW IT WORKS",
   "fontSize": 16,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "text",
   "id": "t2",
   "x": 80,
   "y": 68,
   "text": "How intent is found when it cannot be written first",
   "fontSize": 34,
   "fontFamily": 2,
   "strokeColor": "#2e3a4b"
  },
  {
