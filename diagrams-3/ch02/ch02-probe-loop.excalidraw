   "roughness": 0
  },
  {
   "type": "text",
   "id": "t5",
   "x": 80,
   "y": 138,
   "text": "Hold a clear question, probe cheaply until the answer is real, then write down what you learned.",
   "fontSize": 20,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "text",
   "id": "t6",
   "x": 80,
   "y": 215,
   "text": "THE WATERFALL ASSUMPTION · intent waits in someone's head",
   "fontSize": 15,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
