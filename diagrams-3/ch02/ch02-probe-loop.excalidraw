   "text": "#160 · Stein · 00:07:26",
   "fontSize": 15,
   "fontFamily": 3,
   "strokeColor": "#fdba74"
  },
  {
   "type": "text",
   "id": "t31",
   "x": 1092,
   "y": 265,
   "text": "\"if you asked me I could not\n sit down in front of a Google\n doc and be like oh let me\n like type out what this\n thing should\"",
   "fontSize": 16,
   "fontFamily": 3,
   "strokeColor": "#f5ede4"
  },
  {
   "type": "text",
   "id": "t32",
   "x": 1092,
   "y": 401,
   "text": "#161 · Auchenberg · 00:00:17",
   "fontSize": 15,
   "fontFamily": 3,
   "strokeColor": "#fdba74"
  },
  {
   "type": "text",
   "id": "t33",
   "x": 1092,
   "y": 433,
   "text": "\"building products is really\n about shipping something to\n someone always wins\"",
   "fontSize": 16,
   "fontFamily": 3,
   "strokeColor": "#f5ede4"
  },
  {
   "type": "ellipse",
   "id": "b34",
   "x": 1070,
   "y": 580,
   "width": 400,
   "height": 92,
   "backgroundColor": "#ea580c",
   "strokeColor": "#9a3412",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Probe first. Then\nwrite it down.",
    "fontSize": 21,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
