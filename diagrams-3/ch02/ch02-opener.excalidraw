   "roughness": 0,
   "label": {
    "text": "2",
    "fontSize": 18,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "text",
   "id": "t25",
   "x": 543,
   "y": 522,
   "text": "claims#8 · Dodds",
   "fontSize": 14,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "b26",
   "x": 986,
   "y": 360,
   "width": 423,
   "height": 150,
   "backgroundColor": "#ffffff",
   "strokeColor": "#3f4c5f",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Some intent cannot be\nwritten down first. It is\nfound by building and\nshipping.",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#1f2a3a"
   }
  },
  {
   "type": "ellipse",
