   "strokeColor": "#9a3412",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Decide what to build before you specify it.",
    "fontSize": 22,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "text",
   "id": "t30",
   "x": 720,
   "y": 600,
   "text": "Sources: #1244 — Kent C. Dodds, EpicProduct.engineer · #1245 — Kent C. Dodds, EpicProduct.engineer\n#162 — James Lowe, i.AI · #160 — Ben Stein, Teammates\n#161 — Kenneth Auchenberg, ex-Stripe and VS Code",
