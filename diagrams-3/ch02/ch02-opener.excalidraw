  {
   "type": "text",
   "id": "t19",
   "x": 80,
   "y": 280,
   "text": "this chapter: the step before any document helps",
   "fontSize": 14,
   "fontFamily": 2,
   "strokeColor": "#c2410c"
  },
  {
   "type": "rectangle",
   "id": "b20",
   "x": 80,
   "y": 360,
   "width": 423,
   "height": 150,
   "backgroundColor": "#ffffff",
   "strokeColor": "#3f4c5f",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Code got cheap. Deciding what\nto build is the scarce skill.\nBy default, new capability\ngoes to the wrong things.",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#1f2a3a"
   }
  },
  {
   "type": "ellipse",
   "id": "b21",
   "x": 270,
   "y": 338,
   "width": 42,
   "height": 42,
   "backgroundColor": "#ea580c",
   "strokeColor": "#9a3412",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "1",
    "fontSize": 18,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "text",
   "id": "t22",
   "x": 90,
   "y": 522,
   "text": "claims#7 · Dodds (quoting Raad) · Lowe (quoting Ng)",
   "fontSize": 14,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "b23",
   "x": 533,
   "y": 360,
   "width": 423,
   "height": 150,
   "backgroundColor": "#ffffff",
   "strokeColor": "#3f4c5f",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "The engineer's half:\nconnect what the customer\nneeds to the technical\nchoices.",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#1f2a3a"
   }
  },
  {
   "type": "ellipse",
