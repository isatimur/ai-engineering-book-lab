{
  "type": "excalidraw-skeleton",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 3 · CHAPTER 11 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "title", "x": 80, "y": 68, "text": "How the lights-off factory produces its two failures", "fontSize": 34, "fontFamily": 2, "strokeColor": "#2e3a4b" },
    { "type": "line", "id": "sig_slate", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#475569", "strokeWidth": 3, "roughness": 0 },
    { "type": "line", "id": "sig_orange", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#c2410c", "strokeWidth": 3, "roughness": 0 },
    { "type": "text", "id": "role", "x": 80, "y": 138, "text": "Each crack has a mechanism. The machinery runs fine; what it lacks is judgement and coherence.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "rectangle", "id": "start", "x": 80, "y": 220, "width": 300, "height": 270, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "LIGHTS-OFF\nFACTORY\n\nnobody reads the code\n\"spend more tokens\"\n\"just ship more stuff\"", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7a1a12" } },

    { "type": "text", "id": "h1", "x": 440, "y": 200, "text": "CRACK 1 · THE MISSING CHECK", "fontSize": 15, "fontFamily": 2, "strokeColor": "#b42318" },
    { "type": "rectangle", "id": "m1", "x": 440, "y": 225, "width": 470, "height": 100, "backgroundColor": "#ffffff", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "the human leaves the loop, and with it\nthe last stage where somebody notices\nsomething looks wrong", "fontSize": 17, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "r1", "x": 970, "y": 225, "width": 400, "height": 100, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "OUTAGES\n\"due to coding agent mishaps\"", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7a1a12" } },
    { "type": "arrow", "id": "a1", "x": 382, "y": 275, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#b42318", "strokeWidth": 2, "roughness": 0 },
    { "type": "arrow", "id": "a2", "x": 912, "y": 275, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#b42318", "strokeWidth": 2, "roughness": 0 },

    { "type": "text", "id": "h2", "x": 440, "y": 365, "text": "CRACK 2 · THE LOST WHOLE", "fontSize": 15, "fontFamily": 2, "strokeColor": "#b42318" },
    { "type": "rectangle", "id": "m2", "x": 440, "y": 390, "width": 470, "height": 100, "backgroundColor": "#ffffff", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "codebase too large for a context window\nagents work on slices, with different\ncoding standards in different places", "fontSize": 17, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "r2", "x": 970, "y": 390, "width": 400, "height": 100, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "DECAY\n\"code bases are falling apart\nfaster than they ever have\"", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7a1a12" } },
    { "type": "arrow", "id": "a3", "x": 382, "y": 440, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#b42318", "strokeWidth": 2, "roughness": 0 },
    { "type": "arrow", "id": "a4", "x": 912, "y": 440, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#b42318", "strokeWidth": 2, "roughness": 0 },

    { "type": "text", "id": "n1", "x": 970, "y": 335, "text": "the noticing never left an artifact when it worked", "fontSize": 14, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "n2", "x": 970, "y": 500, "text": "local correctness, global incoherence", "fontSize": 14, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "rectangle", "id": "card", "x": 80, "y": 555, "width": 780, "height": 230, "backgroundColor": "#1f1b17", "strokeColor": "#4a3f35", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
    { "type": "text", "id": "card_head", "x": 105, "y": 573, "text": "the cracks · in the speakers' words", "fontSize": 17, "fontFamily": 3, "strokeColor": "#fdba74" },
    { "type": "text", "id": "card_body", "x": 105, "y": 613, "text": "signal   \"we are starting to see the cracks\"\noutage   \"having outages due to coding agent mishaps\"\ndecay    \"code bases are falling apart faster\n          than they ever have before\"\n                                  (Dex Horthy, HumanLayer)\nslices   \"different coding standards being applied\n          in different places by different agents\"\n                                  (Dan Adler, Sourcegraph)", "fontSize": 16, "fontFamily": 3, "strokeColor": "#f5ede4" },

    { "type": "ellipse", "id": "claim", "x": 900, "y": 580, "width": 470, "height": 150, "backgroundColor": "#ea580c", "strokeColor": "#9a3412", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Harness engineering\nis not enough.", "fontSize": 22, "fontFamily": 2, "strokeColor": "#ffffff" } },

    { "type": "text", "id": "cite", "x": 80, "y": 820, "text": "Sources: #923 — Dex Horthy, HumanLayer · #1237 — Dan Adler, Sourcegraph", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569" }
  ]
}
