{"type": "rectangle", "id": "driver", "x": 880, "y": 230, "width": 240, "height": 240, "backgroundColor": "#fff1e6", "strokeColor": "#c2410c", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "ONE DRIVER\n\nwields the\nexpensive\nAI tools", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7c2d12"}},
