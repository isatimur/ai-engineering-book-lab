{"type": "text", "id": "role", "x": 80, "y": 138, "text": "GEICO's set-up: the experts are the scarce input, so one driver holds the tools.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

{"type": "text", "id": "h1", "x": 80, "y": 200, "text": "THE ROSTER", "fontSize": 16, "fontFamily": 2, "strokeColor": "#c2410c"},
