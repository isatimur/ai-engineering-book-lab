{"type": "text", "id": "h3", "x": 880, "y": 200, "text": "THE OPERATOR", "fontSize": 16, "fontFamily": 2, "strokeColor": "#c2410c"},

{"type": "rectangle", "id": "dm", "x": 80, "y": 230, "width": 300, "height": 100, "backgroundColor": "#fff1e6", "strokeColor": "#c2410c", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "KEY DECISION MAKERS\nfor the topic", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7c2d12"}},
