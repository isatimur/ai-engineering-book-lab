  {
   "type": "text",
   "id": "t19",
   "x": 840,
   "y": 280,
   "text": "this chapter: who checks the check",
   "fontSize": 14,
   "fontFamily": 2,
   "strokeColor": "#c2410c"
  },
  {
   "type": "rectangle",
   "id": "b20",
   "x": 80,
