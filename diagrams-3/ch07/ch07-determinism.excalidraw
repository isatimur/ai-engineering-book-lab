  {
   "type": "text",
   "id": "R_note",
   "x": 750,
   "y": 370,
   "text": "Distributions, not equalities.\nThresholds, not exact matches.\nOne run proves less than it used to.",
   "fontSize": 17,
   "fontFamily": 2,
   "strokeColor": "#1f2a3a"
  },
  {
   "type": "rectangle",
   "id": "R_q",
   "x": 750,
   "y": 470,
   "width": 330,
   "height": 90,
   "backgroundColor": "#fbe0e0",
   "strokeColor": "#b42318",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "\"as soon as an LLM enters\nthe picture, that's all\nout the window\"",
