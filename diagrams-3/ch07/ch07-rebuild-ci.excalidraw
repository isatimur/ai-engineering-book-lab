  },
  {
   "type": "text",
   "id": "card_head",
   "x": 922,
   "y": 246,
   "text": "#837 — as said on stage",
   "fontSize": 16,
   "fontFamily": 3,
   "strokeColor": "#fdba74"
  },
  {
   "type": "text",
   "id": "card_body",
   "x": 922,
   "y": 282,
   "text": "\"Congratulations, you have\nreinvented regression testing.\"\n\n\"One day, it silently fails,\nbut you haven't noticed for a\nweek. So, you build alerts.\nYou just reinvented CI\nmonitoring.\"",
   "fontSize": 17,
   "fontFamily": 3,
   "strokeColor": "#f5ede4"
  },
  {
   "type": "ellipse",
   "id": "claim",
   "x": 940,
   "y": 535,
   "width": 400,
   "height": 100,
   "backgroundColor": "#ea580c",
   "strokeColor": "#9a3412",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "The typical failure is silent.",
    "fontSize": 22,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "rectangle",
   "id": "warn",
   "x": 80,
