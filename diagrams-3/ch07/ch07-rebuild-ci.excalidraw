   "fontFamily": 2,
   "strokeColor": "#b42318"
  },
  {
   "type": "text",
   "id": "colB",
   "x": 540,
   "y": 200,
   "text": "WHAT YOU BUILD IN RESPONSE",
   "fontSize": 16,
   "fontFamily": 2,
   "strokeColor": "#3f4c5f"
  },
  {
   "type": "rectangle",
   "id": "r0a",
   "x": 80,
   "y": 230,
   "width": 380,
   "height": 96,
   "backgroundColor": "#fbe0e0",
   "strokeColor": "#b42318",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "You change a prompt or a skill;\nsomething downstream breaks",
