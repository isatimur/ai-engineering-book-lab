   "label": {
    "text": "ROUND 1 · a nine-line fix\nall three diagnosed it unaided, in under a minute\nonly discriminator: revert the fix, does a test go red?\ncontrol FAILS: working code, no test\ntest-first habit: +1 tool call, ~6k tokens\nartifacts before code: zero in all three arms",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#1f2a3a"
   }
  },
  {
   "type": "rectangle",
   "id": "r2",
   "x": 760,
