   "strokeColor": "#3f4c5f",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "ROUND 2 · sixteen files, two published books at risk\nnew measure: reuse the existing parser, or write a third?\nall three arms passed every measure\ncontrol made the same interface call as the plan arm\nceremony fired for the first time:\n+30% tokens, +50% wall time over the skills arm",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#1f2a3a"
