   "roughness": 0
  },
  {
   "type": "text",
   "id": "card_head",
   "x": 105,
   "y": 728,
   "text": "understanding to participate · Geoffrey Litt",
   "fontSize": 17,
   "fontFamily": 3,
   "strokeColor": "#fdba74"
  },
  {
   "type": "text",
   "id": "card_body",
   "x": 105,
   "y": 768,
   "text": "\"When you review what's happening and get in\n the loop, you come away changed. You understand\n something, and that understanding is what you\n take to the next loop, and the next, and the next.\"\n... \"is not something that we can just wash away\n with better agents.\"",
   "fontSize": 16,
   "fontFamily": 3,
   "strokeColor": "#f5ede4"
  },
  {
   "type": "ellipse",
   "id": "claim",
   "x": 900,
   "y": 730,
   "width": 470,
   "height": 160,
   "backgroundColor": "#ea580c",
   "strokeColor": "#9a3412",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Being right is not\nthe only thing you\nwere there for.",
    "fontSize": 22,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "text",
   "id": "cite",
