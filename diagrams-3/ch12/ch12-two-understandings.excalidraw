  {
   "type": "text",
   "id": "role",
   "x": 80,
   "y": 138,
   "text": "The question moves from \"can I trust it?\" to \"what am I giving up by not looking?\"",
   "fontSize": 20,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "a1",
   "x": 80,
   "y": 205,
   "width": 600,
   "height": 80,
   "backgroundColor": "#fbe0e0",
   "strokeColor": "#b42318",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "IF UNDERSTANDING ONLY CATCHES ERRORS",
    "fontSize": 18,
    "fontFamily": 2,
    "strokeColor": "#7a1a12"
   }
  },
  {
   "type": "rectangle",
   "id": "a2",
   "x": 80,
   "y": 335,
   "width": 600,
   "height": 80,
   "backgroundColor": "#ffffff",
   "strokeColor": "#b42318",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "better models retire the need for it\n\"we don't have to understand it all\"",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#7a1a12"
   }
  },
  {
   "type": "rectangle",
   "id": "a3",
   "x": 80,
   "y": 465,
   "width": 600,
   "height": 80,
   "backgroundColor": "#ffffff",
   "strokeColor": "#b42318",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "leaving the loop is a matter of\nwaiting for accuracy",
    "fontSize": 17,
    "fontFamily": 2,
    "strokeColor": "#7a1a12"
   }
  },
