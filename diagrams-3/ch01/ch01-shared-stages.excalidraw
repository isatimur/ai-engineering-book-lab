    { "type": "rectangle", "id": "e2", "x": 80, "y": 315, "width": 210, "height": 60, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "engineer + agents", "fontSize": 17, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "e3", "x": 80, "y": 395, "width": 210, "height": 60, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "engineer + agents", "fontSize": 17, "fontFamily": 2, "strokeColor": "#1f2a3a" } },

    { "type": "arrow", "id": "ae1", "x": 290, "y": 265, "width": 110, "height": 70, "points": [[0, 0], [110, 70]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0 },
    { "type": "arrow", "id": "ae2", "x": 290, "y": 345, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0 },
    { "type": "arrow", "id": "ae3", "x": 290, "y": 425, "width": 110, "height": -70, "points": [[0, 0], [110, -70]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0 },

    { "type": "text", "id": "q_label", "x": 410, "y": 205, "text": "QUEUE", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "rectangle", "id": "q1", "x": 410, "y": 300, "width": 26, "height": 90, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
    { "type": "rectangle", "id": "q2", "x": 444, "y": 300, "width": 26, "height": 90, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
    { "type": "rectangle", "id": "q3", "x": 478, "y": 300, "width": 26, "height": 90, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
    { "type": "rectangle", "id": "q4", "x": 512, "y": 300, "width": 26, "height": 90, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
