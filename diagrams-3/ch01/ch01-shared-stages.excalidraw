  "elements": [
    { "type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 3 · CHAPTER 1 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "title", "x": 80, "y": 68, "text": "Fast individuals pile up at the shared stages", "fontSize": 34, "fontFamily": 2, "strokeColor": "#2e3a4b" },
    { "type": "line", "id": "sig_slate", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#475569", "strokeWidth": 3, "roughness": 0 },
    { "type": "line", "id": "sig_orange", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#c2410c", "strokeWidth": 3, "roughness": 0 },
    { "type": "text", "id": "role", "x": 80, "y": 138, "text": "Each engineer gets faster with agents. Review, integration and release do not.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "text", "id": "lane_ind", "x": 80, "y": 205, "text": "INDIVIDUALS · faster", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
