{"type": "text", "id": "gap_t", "x": 400, "y": 440, "text": "the gap between commits and releases", "fontSize": 16, "fontFamily": 2, "strokeColor": "#b42318"},

{"type": "rectangle", "id": "card", "x": 80, "y": 500, "width": 840, "height": 200, "backgroundColor": "#1f1b17", "strokeColor": "#4a3f35", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
{"type": "text", "id": "card_head", "x": 102, "y": 516, "text": "#1432 · Tariq Shaukat, Sonar · 00:05:47–00:06:02", "fontSize": 16, "fontFamily": 3, "strokeColor": "#fdba74"},
{"type": "text", "id": "card_body", "x": 102, "y": 554, "text": "\"2,450% increase in lines of code, 240% increase\n in commits, but the same study showed only a\n 30% increase in releases.\"\n\n\"We haven't figured out how to scale from\n producing stuff to shipping stuff.\"", "fontSize": 17, "fontFamily": 3, "strokeColor": "#f5ede4"},
{"type": "ellipse", "id": "claim", "x": 980, "y": 535, "width": 420, "height": 130, "backgroundColor": "#ea580c", "strokeColor": "#9a3412", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "More code did not\nbecome more value.\nIt became a queue.", "fontSize": 22, "fontFamily": 2, "strokeColor": "#ffffff"}},
{"type": "text", "id": "cite", "x": 80, "y": 730, "text": "Source: #1432 — Tariq Shaukat, Sonar (claims#35)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}
]
