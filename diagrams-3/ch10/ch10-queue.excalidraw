{"type": "rectangle", "id": "gap", "x": 560, "y": 300, "width": 680, "height": 126, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "strokeStyle": "dashed", "label": {"text": "THE QUEUE\nwork that was done and has not reached anyone:\nwaiting in review or in the deployment gap", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7a1a12"}},
