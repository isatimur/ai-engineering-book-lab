{"type": "text", "id": "card_head", "x": 102, "y": 706, "text": "#89 · Dex Horthy, HumanLayer · 00:17:14", "fontSize": 16, "fontFamily": 3, "strokeColor": "#fdba74"},
{"type": "text", "id": "card_body", "x": 102, "y": 742, "text": "\"a bad line of code is a bad line of code\"\n\nclaims#16: errors multiply upstream, so human\nreview belongs on research and plans", "fontSize": 17, "fontFamily": 3, "strokeColor": "#f5ede4"},
{"type": "ellipse", "id": "claim", "x": 980, "y": 700, "width": 420, "height": 130, "backgroundColor": "#ea580c", "strokeColor": "#9a3412", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "Do not read faster.\nRead upstream.", "fontSize": 26, "fontFamily": 2, "strokeColor": "#ffffff"}},
{"type": "text", "id": "cite", "x": 80, "y": 870, "text": "Sources: #89 — Dex Horthy, HumanLayer (claims#16) · #1237 — Dan Adler, Sourcegraph (claims#31, coherence)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}
