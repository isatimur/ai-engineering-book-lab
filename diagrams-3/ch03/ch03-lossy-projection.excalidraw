  {
   "type": "text",
   "id": "role",
   "x": 80,
   "y": 138,
   "text": "The specification keeps the why. The code keeps only what runs.",
   "fontSize": 20,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "b3",
   "x": 80,
   "y": 220,
   "width": 280,
   "height": 190,
   "backgroundColor": "#fff1e6",
   "strokeColor": "#c2410c",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "THE WORK BEFORE CODE\ntalking with people\ngathering requirements\nthinking through\nimplementation",
    "fontSize": 16,
    "fontFamily": 2,
    "strokeColor": "#7c2d12"
   }
  },
  {
   "type": "rectangle",
   "id": "b4",
   "x": 440,
   "y": 240,
   "width": 260,
   "height": 150,
   "backgroundColor": "#e6ebf1",
   "strokeColor": "#3f4c5f",
   "strokeWidth": 3,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "SPECIFICATION\nkeeps the intent\nand the reasons",
    "fontSize": 18,
    "fontFamily": 2,
    "strokeColor": "#3f4c5f"
   }
  },
  {
   "type": "rectangle",
   "id": "b5",
   "x": 800,
