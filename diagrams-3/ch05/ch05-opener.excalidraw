    { "type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 3 · CHAPTER 5 · THE ARGUMENT", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "title", "x": 80, "y": 68, "text": "Execution Under a Spec", "fontSize": 36, "fontFamily": 2, "strokeColor": "#2e3a4b" },
    { "type": "line", "id": "sig_slate", "x": 80, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#475569", "strokeWidth": 3, "roughness": 0 },
    { "type": "line", "id": "sig_orange", "x": 190, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#c2410c", "strokeWidth": 3, "roughness": 0 },
    { "type": "text", "id": "role", "x": 80, "y": 140, "text": "Once the plan runs, only two things hold the agent to it: what it can reach, and what gets checked.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "rectangle", "id": "p1", "x": 80, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "intent", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "rectangle", "id": "p2", "x": 270, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "spec", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "rectangle", "id": "p3", "x": 460, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "plan", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "rectangle", "id": "p4", "x": 650, "y": 200, "width": 150, "height": 44, "backgroundColor": "#ea580c", "strokeColor": "#9a3412", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "code (execution)", "fontSize": 17, "fontFamily": 2, "strokeColor": "#ffffff" } },
    { "type": "rectangle", "id": "p5", "x": 840, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "gates", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "rectangle", "id": "p6", "x": 1030, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "review", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "rectangle", "id": "p7", "x": 1220, "y": 200, "width": 150, "height": 44, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 1, "fillStyle": "solid", "roughness": 0, "label": { "text": "live", "fontSize": 17, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
