    { "type": "arrow", "id": "pa5", "x": 992, "y": 222, "width": 36, "height": 0, "points": [[0, 0], [36, 0]], "strokeColor": "#94a3b8", "strokeWidth": 2, "roughness": 0 },
    { "type": "arrow", "id": "pa6", "x": 1182, "y": 222, "width": 36, "height": 0, "points": [[0, 0], [36, 0]], "strokeColor": "#94a3b8", "strokeWidth": 2, "roughness": 0 },
    { "type": "text", "id": "pnote", "x": 650, "y": 252, "text": "this chapter: the stage where the plan runs", "fontSize": 15, "fontFamily": 2, "strokeColor": "#94a3b8" },

    { "type": "rectangle", "id": "from", "x": 80, "y": 300, "width": 300, "height": 80, "backgroundColor": "#fbe0e0", "strokeColor": "#b42318", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "THE WRITTEN PLAN\nadvisory once it runs", "fontSize": 18, "fontFamily": 2, "strokeColor": "#b42318" } },
    { "type": "rectangle", "id": "to", "x": 1070, "y": 300, "width": 300, "height": 80, "backgroundColor": "#e6ebf1", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "CONSTRAINTS + CHECKS\nwhat binds the agent", "fontSize": 18, "fontFamily": 2, "strokeColor": "#3f4c5f" } },
    { "type": "arrow", "id": "band", "x": 382, "y": 340, "width": 686, "height": 0, "points": [[0, 0], [686, 0]], "strokeColor": "#3f4c5f", "strokeWidth": 4, "roughness": 0 },

    { "type": "text", "id": "bandnote", "x": 470, "y": 306, "text": "a constraint the agent cannot violate  +  a step whose completion is a fact", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "rectangle", "id": "c1", "x": 80, "y": 440, "width": 305, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Isolation, not approval\nclicking, makes an\nunattended agent\naffordable", "fontSize": 18, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "c2", "x": 408, "y": 440, "width": 305, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "A crisp spec plus a\nmechanical check\nparallelises at scale now", "fontSize": 18, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "c3", "x": 736, "y": 440, "width": 305, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#3f4c5f", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Where a feature only\norchestrates, instructions\ncan replace the code", "fontSize": 18, "fontFamily": 2, "strokeColor": "#1f2a3a" } },
    { "type": "rectangle", "id": "c4", "x": 1064, "y": 440, "width": 305, "height": 150, "backgroundColor": "#fff1e6", "strokeColor": "#c2410c", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Parallel async agents\nturn execution into a\ncoordination problem\nfor people", "fontSize": 18, "fontFamily": 2, "strokeColor": "#7c2d12" } },

