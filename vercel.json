{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"install handled in buildCommand\"",
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.fromcopilottocolleague.com" }],
      "destination": "https://fromcopilottocolleague.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.aiepress.com" }],
      "destination": "https://aiepress.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.fromcopilottocolleague.com" }],
      "destination": "https://fromcopilottocolleague.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aiepress.com" }],
      "destination": "https://aiepress.com/:path*",
      "permanent": true
    }
  ]
}
