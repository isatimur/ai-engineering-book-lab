{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.fromcopilottocolleague.com"
        }
      ],
      "destination": "https://fromcopilottocolleague.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fromcopilottocolleague.com"
        }
      ],
      "destination": "https://fromcopilottocolleague.com/:path*",
      "permanent": true
    }
  ]
}
