    {
      "id": "g9004",
      "text": "The Failure Surface Stretches",
      "translation": "Зона ошибок растягивается",
      "where": "free text"
    },
    {
      "id": "g9013",
      "text": "Suggestion is supervised by construction. Delegation isn't.",
      "translation": "Подсказку человек проверяет по определению. Делегирование — нет.",
      "where": "free text"
    },
    {
      "id": "g9016",
      "text": "ASSISTANT — “tell me”   ·   human reads every word",
      "translation": "АССИСТЕНТ — «скажи мне»   ·   человек читает каждое слово",
      "where": "free text"
    },
    {
      "id": "g9022",
      "text": "Ask",
      "translation": "Вопрос",
      "where": "free text inside rectangle g9019",
      "budget_px": 110,
      "budget_chars_per_line": 11
    },
    {
      "id": "g9031",
      "text": "Suggest",
      "translation": "Подсказка",
      "where": "free text inside rectangle g9028",
      "budget_px": 140,
      "budget_chars_per_line": 14
    },
    {
      "id": "g9040",
      "text": "Human reads  ✓",
      "translation": "Человек читает ✓",
      "where": "free text inside rectangle g9037",
      "budget_px": 170,
      "budget_chars_per_line": 18
    },
    {
      "id": "g9043",
      "text": "✗ caught here",
      "translation": "✗ поймана здесь",
      "where": "free text"
    },
    {
      "id": "g9049",
      "text": "failure surface: one response",
      "translation": "зона ошибок: один ответ",
      "where": "free text"
    },
    {
      "id": "g9052",
      "text": "a wrong suggestion = a wrong sentence, caught in context",
      "translation": "неверная подсказка = неверная фраза, её видно сразу",
      "where": "free text"
    },
    {
      "id": "g9055",
      "text": "DELEGATE — “go do”   ·   human waits for the result",
      "translation": "ИСПОЛНИТЕЛЬ — «сделай»   ·   человек ждёт результат",
      "where": "free text"
    },
    {
      "id": "g9061",
      "text": "Delegate",
