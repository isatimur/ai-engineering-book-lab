    {
      "type": "text",
      "id": "ce_evidence_txt",
      "x": 70,
      "y": 506,
      "width": 569.49,
      "height": 108.0,
      "text": "# постепенное обнаружение инструментов — сначала сузить, потом каталог\ndef assemble_context(task):\n    tools = registry.match(intent=task.intent, limit=8)   # не все 200\n    docs  = retriever.rank(task.query)[:5]                # топ-5, с оценкой\n    return ContextSet(instructions=task.spec, tools=tools, evidence=docs,\n                      budget_tokens=12_000)               # бюджет — это гарантия",
      "originalText": "# постепенное обнаружение инструментов — сначала сузить, потом каталог\ndef assemble_context(task):\n    tools = registry.match(intent=task.intent, limit=8)   # не все 200\n    docs  = retriever.rank(task.query)[:5]                # топ-5, с оценкой\n    return ContextSet(instructions=task.spec, tools=tools, evidence=docs,\n                      budget_tokens=12_000)               # бюджет — это гарантия",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#86efac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
