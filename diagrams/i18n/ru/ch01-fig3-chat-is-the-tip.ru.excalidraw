    {
      "type": "text",
      "id": "basenote",
      "x": 146,
      "y": 372,
      "width": 471.06,
      "height": 33.6,
      "text": "Структура процесса, трейсы, боковые панели, память, очереди ревью —\nобвязка растёт, потому что именно она несёт надёжность.",
      "originalText": "Структура процесса, трейсы, боковые панели, память, очереди ревью —\nобвязка растёт, потому что именно она несёт надёжность.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#4c1d95",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 3103042,
      "version": 2,
      "versionNonce": 3103042,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.4
    },
