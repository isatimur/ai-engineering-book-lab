    {
      "id": "g92004",
      "text": "Comprehension Stops Being Free",
      "translation": "Понимание перестаёт быть бесплатным",
      "where": "free text"
    },
    {
      "id": "g92013",
      "text": "When you wrote every line, understanding came bundled with authorship. A model unbundles it.",
