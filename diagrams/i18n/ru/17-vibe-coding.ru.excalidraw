    {
      "type": "text",
      "id": "vc_ev_bad",
      "x": 68,
      "y": 520,
      "width": 337.48,
      "height": 72.0,
      "text": "# навайблено, выпущено без проверки\nfn charge(u) { stripe.charge(u.card, u.amt) }\n  # нет проверки прав, нет ключа идемпотентности\n  # нет теста -> двойное списание при повторе",
      "originalText": "# навайблено, выпущено без проверки\nfn charge(u) { stripe.charge(u.card, u.amt) }\n  # нет проверки прав, нет ключа идемпотентности\n  # нет теста -> двойное списание при повторе",
