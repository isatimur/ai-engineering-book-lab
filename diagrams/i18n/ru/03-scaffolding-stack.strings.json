      "budget_chars_per_line": 40
    },
    {
      "id": "model_c",
      "text": "Capable, fast, cheap — and not yet dependable.",
      "translation": "Способная, быстрая, дешёвая — и пока ненадёжная.",
      "where": "free text inside rectangle model",
      "budget_px": 590,
      "budget_chars_per_line": 75
