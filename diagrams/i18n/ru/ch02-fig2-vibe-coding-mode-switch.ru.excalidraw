      "width": 166.98,
      "height": 23.75,
      "text": "Вайб-инжиниринг",
      "originalText": "Вайб-инжиниринг",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#065f46",
