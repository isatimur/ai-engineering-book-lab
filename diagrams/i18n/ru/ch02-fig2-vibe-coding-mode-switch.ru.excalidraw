    {
      "type": "text",
      "id": "pl_h",
      "x": 58,
      "y": 156,
      "width": 196.86,
      "height": 15.0,
      "text": "РЕЖИМ ПОИСКА  —  ИСПОЛЬЗУЙТЕ",
      "originalText": "РЕЖИМ ПОИСКА  —  ИСПОЛЬЗУЙТЕ",
