    },
    {
      "type": "text",
      "id": "pl_b",
      "x": 58,
      "y": 212,
      "width": 190.42,
      "height": 156.0,
      "text": "Цель: поиск — понять,\nчто стоит строить.\n\nПодходит для:\n  • черновых прототипов\n  • набросков интерфейса\n  • внутренних утилит\n  • разовой автоматизации",
      "originalText": "Цель: поиск — понять,\nчто стоит строить.\n\nПодходит для:\n  • черновых прототипов\n  • набросков интерфейса\n  • внутренних утилит\n  • разовой автоматизации",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 3202013,
