    {
      "type": "text",
      "id": "pr_code",
      "x": 852,
      "y": 334,
      "width": 288.26,
      "height": 144.0,
      "text": "/* Удваивает каждое показание датчика.\n   Неверный ввод — ошибка вызывающего. */\nfunction doubleReadings(\n  readings: Reading[]\n): number[] {\n  return readings.map(r => r.value * 2)\n}\n// + тест, фиксирующий контракт",
      "originalText": "/* Удваивает каждое показание датчика.\n   Неверный ввод — ошибка вызывающего. */\nfunction doubleReadings(\n  readings: Reading[]\n): number[] {\n  return readings.map(r => r.value * 2)\n}\n// + тест, фиксирующий контракт",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#86efac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
