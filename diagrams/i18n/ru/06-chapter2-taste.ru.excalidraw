    {
      "type": "text",
      "id": "pl_code",
      "x": 112,
      "y": 334,
      "width": 330.45,
      "height": 144.0,
      "text": "function h(d) {\n  let r = []\n  for (i in d) {\n    try { r.push(d[i].val * 2) }\n    catch (e) {}          // ошибка проглочена\n  }\n  return r                // i утекает в global\n}",
      "originalText": "function h(d) {\n  let r = []\n  for (i in d) {\n    try { r.push(d[i].val * 2) }\n    catch (e) {}          // ошибка проглочена\n  }\n  return r                // i утекает в global\n}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#fca5a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
