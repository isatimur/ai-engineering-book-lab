      "id": "he_evidence_txt",
      "x": 70,
      "y": 506,
      "width": 562.46,
      "height": 90.0,
      "text": "# AGENTS.md — правила обвязки для всего репозитория, агент обязан их соблюдать\nedit_boundaries:  [\"src/**\", \"tests/**\"]   # не трогать infra/, .github/\nvalidation:       \"pytest -q && ruff check .\"  # должно пройти до выпуска\nplan_first:       true                       # написать PLAN.md, ждать одобрения\nsubagents:        { reviewer: \"adversarial\", scope: \"diff-only\" }",
