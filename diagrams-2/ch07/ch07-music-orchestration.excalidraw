  {"type": "arrow", "id": "ba2", "x": 622, "y": 595, "width": 76, "height": 0, "points": [[0, 0], [76, 0]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0},
  {"type": "arrow", "id": "ba3", "x": 932, "y": 595, "width": 76, "height": 0, "points": [[0, 0], [76, 0]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0},
  {"type": "text", "id": "b_note", "x": 1265, "y": 575, "text": "a pipeline to\nassemble, not a\nbutton to press", "fontSize": 14, "fontFamily": 2, "strokeColor": "#475569"},

  {"type": "rectangle", "id": "card", "x": 80, "y": 680, "width": 760, "height": 120, "backgroundColor": "#0b2b2e", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
  {"type": "text", "id": "card_h", "x": 100, "y": 692, "text": "what the talks say", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "text", "id": "card_b", "x": 100, "y": 720, "text": "Schaeff: \"a tool to then generate a song using Lyra.\"\nYoung:   \"produce a song and then use this voice\n          conversion technique\"", "fontSize": 16, "fontFamily": 3, "strokeColor": "#ccfbf1"},

  {"type": "ellipse", "id": "claim", "x": 900, "y": 690, "width": 500, "height": 100, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "The craft is the composition,\nnot one great model.", "fontSize": 21, "fontFamily": 2, "strokeColor": "#ffffff"}},

  {"type": "text", "id": "cite", "x": 80, "y": 830, "text": "Sources: #755 Thor Schaeff (Google DeepMind) · #477 Phlo Young", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}
