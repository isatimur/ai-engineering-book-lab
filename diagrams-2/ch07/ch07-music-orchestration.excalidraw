 "elements": [
  {"type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 2 · CHAPTER 7 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b"},
  {"type": "text", "id": "title", "x": 80, "y": 68, "text": "Music as orchestration: specialized models, composed", "fontSize": 34, "fontFamily": 2, "strokeColor": "#155e75"},
  {"type": "line", "id": "sig_teal", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0},
  {"type": "line", "id": "sig_rose", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0},
  {"type": "text", "id": "role", "x": 80, "y": 138, "text": "No single generator makes the song. Each part does one job; the product is how they fit together.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "text", "id": "a_h", "x": 80, "y": 200, "text": "GEMINI'S AUDIO STACK", "fontSize": 16, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "rectangle", "id": "user", "x": 80, "y": 315, "width": 200, "height": 80, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a person,\ntalking live", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "arrow", "id": "u_c", "x": 282, "y": 355, "width": 276, "height": 0, "points": [[0, 0], [276, 0]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "startArrowhead": "arrow", "endArrowhead": "arrow"},
  {"type": "text", "id": "u_c_l", "x": 330, "y": 368, "text": "speech in, speech out", "fontSize": 14, "fontFamily": 2, "strokeColor": "#475569"},
  {"type": "rectangle", "id": "conv", "x": 560, "y": 295, "width": 340, "height": 120, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": {"text": "conversational model\nnative speech-to-speech\n(no transcribe-then-speak cascade)", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"}},

  {"type": "rectangle", "id": "r1", "x": 1000, "y": 225, "width": 400, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "reads a recording: speaker · emotion ·\nlanguage, in one structured call", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r2", "x": 1000, "y": 320, "width": 400, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a small set of base voices,\nsteered by a written \"director's note\"", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r3", "x": 1000, "y": 415, "width": 400, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "Lyra, a separate music model,\nset to compose a song on request", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "line", "id": "c_r1", "x": 902, "y": 330, "width": 96, "height": -70, "points": [[0, 0], [96, -70]], "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0},
  {"type": "line", "id": "c_r2", "x": 902, "y": 355, "width": 96, "height": 0, "points": [[0, 0], [96, 0]], "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0},
  {"type": "arrow", "id": "c_r3", "x": 902, "y": 385, "width": 96, "height": 65, "points": [[0, 0], [96, 65]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
