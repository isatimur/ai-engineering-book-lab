  {"type": "text", "id": "b_h", "x": 80, "y": 530, "text": "FROM PROMPT TO PRODUCTION", "fontSize": 16, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "rectangle", "id": "b1", "x": 80, "y": 565, "width": 230, "height": 60, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a prompt", "fontSize": 17, "fontFamily": 3, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "b2", "x": 390, "y": 565, "width": 230, "height": 60, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "produce a song", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "b3", "x": 700, "y": 565, "width": 230, "height": 60, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "voice conversion", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "b4", "x": 1010, "y": 565, "width": 230, "height": 60, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "production", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"}},
