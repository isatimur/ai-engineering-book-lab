  {"type": "arrow", "id": "ref", "x": 435, "y": 330, "width": 595, "height": 40, "points": [[0, 0], [0, 40], [595, 40], [595, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 0},
  {"type": "text", "id": "ref_t", "x": 560, "y": 376, "text": "the engine's numbers are the reference for the check", "fontSize": 15, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "text", "id": "catch_t", "x": 1110, "y": 336, "text": "a hallucinated figure is\ncaught before it reaches\nthe taxpayer", "fontSize": 15, "fontFamily": 2, "strokeColor": "#a8412e"},

  {"type": "text", "id": "h2", "x": 80, "y": 432, "text": "EVERY TAX YEAR AND EVERY MODEL UPGRADE · THE EVAL RUNS AGAIN", "fontSize": 16, "fontFamily": 2, "strokeColor": "#be185d"},
  {"type": "rectangle", "id": "c1", "x": 80, "y": 462, "width": 330, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#be185d", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "IRS forms change, or a\nsame-vendor model upgrade lands", "fontSize": 16, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "arrow", "id": "c1a", "x": 412, "y": 497, "width": 66, "height": 0, "points": [[0, 0], [66, 0]], "strokeColor": "#be185d", "strokeWidth": 2, "roughness": 0},
