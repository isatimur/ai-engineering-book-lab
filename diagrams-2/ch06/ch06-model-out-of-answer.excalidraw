  {"type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 2 · CHAPTER 6 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b"},
  {"type": "text", "id": "title", "x": 80, "y": 68, "text": "Intuit's tax assistant explains the number but never computes it", "fontSize": 34, "fontFamily": 2, "strokeColor": "#155e75"},
  {"type": "line", "id": "sig_teal", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0},
  {"type": "line", "id": "sig_rose", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0},
  {"type": "text", "id": "role", "x": 80, "y": 138, "text": "A wrong tax number is legal liability, so the model works only where it is safe: the explanation.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "text", "id": "h1", "x": 80, "y": 196, "text": "EVERY ANSWER · THE NUMBER NEVER COMES FROM THE MODEL", "fontSize": 16, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "rectangle", "id": "b1", "x": 80, "y": 236, "width": 180, "height": 84, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "the taxpayer's\nreturn", "fontSize": 16, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "arrow", "id": "b1a", "x": 262, "y": 278, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b2", "x": 320, "y": 228, "width": 230, "height": 100, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": {"text": "deterministic\ntax engine\ncomputes every figure", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"}},
  {"type": "arrow", "id": "b2a", "x": 552, "y": 278, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b3", "x": 610, "y": 236, "width": 220, "height": 84, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "LLM writes the\nexplanation", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "arrow", "id": "b3a", "x": 832, "y": 278, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b4", "x": 890, "y": 228, "width": 280, "height": 100, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": {"text": "guardrail model checks\nthe explanation against\nthe real numbers", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"}},
