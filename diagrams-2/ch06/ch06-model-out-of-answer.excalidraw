  {"type": "rectangle", "id": "card", "x": 80, "y": 576, "width": 820, "height": 146, "backgroundColor": "#0b2b2e", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
  {"type": "text", "id": "card_h", "x": 100, "y": 588, "text": "what the talk says (#197)", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "text", "id": "card_b", "x": 100, "y": 616, "text": "scale: \"TurboTax successfully processed 44 million\n        tax returns for tax year 23\"\nchange: \"the only way it's possible is because we\n         have clear eval in place so that we can\n         test out whatever we are changing\"", "fontSize": 15, "fontFamily": 3, "strokeColor": "#ccfbf1"},
  {"type": "ellipse", "id": "claim", "x": 930, "y": 590, "width": 470, "height": 120, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "The model explains\nthe number. It never\nmakes it.", "fontSize": 21, "fontFamily": 2, "strokeColor": "#ffffff"}},
