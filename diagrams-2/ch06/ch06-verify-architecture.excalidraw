  {"type": "rectangle", "id": "b1", "x": 80, "y": 358, "width": 180, "height": 84, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "very large\nfinancial corpus", "fontSize": 16, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "arrow", "id": "b1a", "x": 262, "y": 400, "width": 61, "height": 0, "points": [[0, 0], [61, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b2", "x": 325, "y": 358, "width": 200, "height": 84, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "agent drafts a\nfinding (e.g. a\nrisk factor)", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "arrow", "id": "b2a", "x": 527, "y": 400, "width": 61, "height": 0, "points": [[0, 0], [61, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b3", "x": 590, "y": 350, "width": 260, "height": 100, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": {"text": "a SEPARATE model call\nchecks the finding\nagainst the source doc", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"}},
  {"type": "arrow", "id": "b3a", "x": 852, "y": 400, "width": 61, "height": 0, "points": [[0, 0], [61, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "b4", "x": 915, "y": 358, "width": 220, "height": 84, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "finding + citation\n+ audit trail", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
