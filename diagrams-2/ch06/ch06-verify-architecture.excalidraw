 "elements": [
  {"type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 2 · CHAPTER 6 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b"},
  {"type": "text", "id": "title", "x": 80, "y": 68, "text": "Verification is a separate call, and every claim carries its source", "fontSize": 34, "fontFamily": 2, "strokeColor": "#155e75"},
  {"type": "line", "id": "sig_teal", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0},
  {"type": "line", "id": "sig_rose", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0},
  {"type": "text", "id": "role", "x": 80, "y": 138, "text": "In finance and law, a claim you cannot trace to a source is worthless.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "text", "id": "a_h", "x": 80, "y": 200, "text": "NAIVE · ONE PASS, SELF-CHECKED", "fontSize": 16, "fontFamily": 2, "strokeColor": "#a8412e"},
  {"type": "rectangle", "id": "a1", "x": 80, "y": 228, "width": 245, "height": 64, "backgroundColor": "#ffffff", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "agent drafts a finding", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "arrow", "id": "a1a", "x": 327, "y": 260, "width": 61, "height": 0, "points": [[0, 0], [61, 0]], "strokeColor": "#a8412e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "a2", "x": 390, "y": 228, "width": 265, "height": 64, "backgroundColor": "#ffffff", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "the same model\nreviews its own output", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "arrow", "id": "a2a", "x": 657, "y": 260, "width": 61, "height": 0, "points": [[0, 0], [61, 0]], "strokeColor": "#a8412e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "a3", "x": 720, "y": 228, "width": 300, "height": 64, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "\"primed to be credulous\"", "fontSize": 18, "fontFamily": 2, "strokeColor": "#a8412e"}},

