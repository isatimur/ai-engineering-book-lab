  {"type": "rectangle", "id": "card", "x": 80, "y": 490, "width": 820, "height": 214, "backgroundColor": "#0b2b2e", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
  {"type": "text", "id": "card_h", "x": 100, "y": 502, "text": "Harvey · one legal query, three kinds of retrieval", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "text", "id": "card_b", "x": 100, "y": 530, "text": "query: applicable regime for a class of covered\n       bonds issued before <date>, under\n       <EU directive>, <article>\n\nsemantic search  →  \"applicable regime ... covered bonds\"\ndate filter      →  issued before <date>\nexact IDs        →  <EU directive>, <article>", "fontSize": 15, "fontFamily": 3, "strokeColor": "#ccfbf1"},
  {"type": "text", "id": "card_n", "x": 100, "y": 678, "text": "the eval proves the right law came back: \"eval driven development\"", "fontSize": 14, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "ellipse", "id": "claim", "x": 930, "y": 520, "width": 470, "height": 130, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "\"Trust, but verify\"\nis an architecture,\nnot a slogan.", "fontSize": 21, "fontFamily": 2, "strokeColor": "#ffffff"}},
  {"type": "text", "id": "tags", "x": 950, "y": 664, "text": "claims#33", "fontSize": 13, "fontFamily": 2, "strokeColor": "#64748b"},

