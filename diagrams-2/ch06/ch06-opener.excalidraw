  {"type": "ellipse", "id": "claim", "x": 360, "y": 658, "width": 760, "height": 100, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "The stake is the standard: verification stops being\na nicety and becomes the thing customers buy.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#ffffff"}},

  {"type": "text", "id": "cite", "x": 80, "y": 786, "text": "Sources: #423 Conover (Brightwave) · #154 Qi & She (Harvey, LanceDB) · #406 Alshikh (Writer) · #473 Pekelis (Gradient) · #86 Myshatyn (Los Alamos)\n#469 Morina (AXA) · #187 Wan (Ensemble Health) · #883 Shankhdhar (Risa Labs) · #446 Anterior · #938 Reed & Revere (SonderMind) · #197 Singh (Intuit) · #339 Mason", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}
