  {"type": "text", "id": "role", "x": 80, "y": 140, "text": "The methods stay general. The error tolerance drops to zero, and that reshapes every one of them.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "text", "id": "top_h", "x": 80, "y": 200, "text": "THE GENERIC PLAYBOOK ASSUMES", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b"},
  {"type": "rectangle", "id": "p1", "x": 80, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "a model can check\nits own output", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p2", "x": 271, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "a general model\nis good enough", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p3", "x": 462, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "compliance is a\ndeployment detail", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p4", "x": 653, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "medical AI belongs\nat the bedside", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p5", "x": 844, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "eval is a checkpoint\nbefore launch", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p6", "x": 1035, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "an offline eval\nset is enough", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},
  {"type": "rectangle", "id": "p7", "x": 1226, "y": 228, "width": 176, "height": 72, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "automate it\nend to end", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569"}},

