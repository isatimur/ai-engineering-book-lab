  {"type": "rectangle", "id": "r1", "x": 80, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a separate call\nverifies each\nfinding; every\nclaim cites a source", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r2", "x": 271, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "best grounding\nscore ~81%:\nroughly 1 in 5 wrong,\nso train for the domain", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r3", "x": 462, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "NIST 800-53,\nFedRAMP, self-\nhosting: decided\non day one", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r4", "x": 653, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "value sits in the\nback office: denials,\nappeals, prior\nauthorisation", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r5", "x": 844, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "eval is the product;\na clinician, not\nthe engineer,\ndefines \"correct\"", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r6", "x": 1035, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "eval runs on every\nlive case and on\nevery model\nupgrade", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r7", "x": 1226, "y": 444, "width": 176, "height": 130, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a confidence gate,\na named human\non call, a hard\nstop", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},

