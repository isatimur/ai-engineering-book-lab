  {"type": "rectangle", "id": "card", "x": 80, "y": 610, "width": 820, "height": 150, "backgroundColor": "#0b2b2e", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
  {"type": "text", "id": "card_h", "x": 100, "y": 622, "text": "the same gate in other high-stakes systems", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "text", "id": "card_b", "x": 100, "y": 650, "text": "Anterior   low confidence → \"give it to an on call\n           clinician to review it\"\nEnsemble   clinical expert signs off before the\n           appeal letter reaches the payer\nBrightwave no full autonomy on judgment calls", "fontSize": 15, "fontFamily": 3, "strokeColor": "#ccfbf1"},
  {"type": "ellipse", "id": "claim", "x": 930, "y": 440, "width": 470, "height": 130, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "The human is where\nthe unbounded risk\nis parked, by design.", "fontSize": 21, "fontFamily": 2, "strokeColor": "#ffffff"}},
