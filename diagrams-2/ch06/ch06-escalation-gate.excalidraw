  {"type": "rectangle", "id": "e1", "x": 80, "y": 442, "width": 300, "height": 56, "backgroundColor": "#ffffff", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "case falls outside the script", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
