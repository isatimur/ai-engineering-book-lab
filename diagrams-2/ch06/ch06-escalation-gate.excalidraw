  {"type": "text", "id": "role", "x": 80, "y": 138, "text": "Dan Mason's telemedicine support agent makes the human boundary part of the architecture.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "text", "id": "h1", "x": 80, "y": 196, "text": "EVERY OUTGOING MESSAGE", "fontSize": 16, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "rectangle", "id": "m1", "x": 80, "y": 240, "width": 250, "height": 96, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "agent drafts a reply\nfrom medically approved\nscripts (co-owned by a\nphysician's assistant)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "arrow", "id": "m1a", "x": 332, "y": 288, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
  {"type": "rectangle", "id": "m2", "x": 390, "y": 240, "width": 270, "height": 96, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": {"text": "separate self-evaluation\nscores the message; cuts\nconfidence for unusual cases", "fontSize": 15, "fontFamily": 2, "strokeColor": "#0f766e"}},
  {"type": "arrow", "id": "m2a", "x": 662, "y": 288, "width": 56, "height": 0, "points": [[0, 0], [56, 0]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},
