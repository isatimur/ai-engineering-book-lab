   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "1  A benchmark captures\nthe field's attention",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#134e4a"
   }
  },
  {
