  {
   "type": "text",
   "id": "role",
   "x": 80,
   "y": 138,
   "text": "What the field agrees to measure becomes what the labs optimize, and so what gets built.",
   "fontSize": 20,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "s1",
