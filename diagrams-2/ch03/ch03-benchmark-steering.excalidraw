  {
   "type": "text",
   "id": "loop_l",
   "x": 470,
   "y": 385,
   "text": "a self-fulfilling prophecy: whoever builds the benchmark shapes the future",
   "fontSize": 17,
   "fontFamily": 2,
   "strokeColor": "#0f766e"
  },
  {
   "type": "rectangle",
   "id": "weak",
   "x": 80,
   "y": 450,
   "width": 620,
   "height": 150,
   "backgroundColor": "#f5d5d0",
   "strokeColor": "#a8412e",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "The weak point: building good benchmarks\nis what practitioners find hardest.\nA field that cannot measure well drives\ntoward whatever is easiest to score.",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#4d1d13"
   }
  },
  {
   "type": "rectangle",
   "id": "card",
