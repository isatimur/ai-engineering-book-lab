  {
   "type": "text",
   "id": "role",
   "x": 80,
   "y": 138,
   "text": "The frontier stopped being a club of two labs. It is now a discipline with many practitioners.",
   "fontSize": 20,
   "fontFamily": 2,
   "strokeColor": "#64748b"
  },
  {
   "type": "rectangle",
   "id": "quote",
   "x": 80,
   "y": 200,
   "width": 1320,
   "height": 60,
   "backgroundColor": "#e11d48",
   "strokeColor": "#881337",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "\"You do not need a billion dollars to compete with the big labs.\"   #439 Eugene Cheah, Featherless.ai",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#ffffff"
   }
  },
  {
   "type": "text",
   "id": "ma",
   "x": 80,
   "y": 300,
   "text": "MOVEMENT A \u00b7 HOW A LAB ADVANCES \u00b7 the method",
   "fontSize": 18,
   "fontFamily": 2,
   "strokeColor": "#0f766e"
  },
  {
   "type": "rectangle",
   "id": "b14",
   "x": 80,
   "y": 335,
   "width": 420,
   "height": 120,
   "backgroundColor": "#ccfbf1",
   "strokeColor": "#0f766e",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "\"Stagnation\" is a training-budget lag,\nnot a ceiling\nclaims#14",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#134e4a"
   }
  },
  {
   "type": "rectangle",
   "id": "b15",
   "x": 530,
   "y": 335,
   "width": 420,
   "height": 120,
   "backgroundColor": "#ccfbf1",
   "strokeColor": "#0f766e",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Progress is bottleneck-hunting:\nfix the root, skip the leaves\nclaims#15",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#134e4a"
   }
  },
  {
   "type": "rectangle",
   "id": "b16",
   "x": 980,
   "y": 335,
   "width": 420,
   "height": 120,
   "backgroundColor": "#ccfbf1",
   "strokeColor": "#0f766e",
   "strokeWidth": 2,
   "fillStyle": "solid",
   "roughness": 0,
   "label": {
    "text": "Reasoning work starts in code,\na sandbox the model can execute\nclaims#16",
    "fontSize": 19,
    "fontFamily": 2,
    "strokeColor": "#134e4a"
   }
  },
  {
   "type": "arrow",
   "id": "down",
   "x": 740,
   "y": 470,
   "width": 0,
   "height": 105,
   "points": [
