  {"type": "rectangle", "id": "k1", "x": 80, "y": 372, "width": 248, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "audio is not\na sequence of words", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "rectangle", "id": "k2", "x": 348, "y": 372, "width": 248, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a voice agent that\npauses breaks the illusion", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "rectangle", "id": "k3", "x": 616, "y": 372, "width": 248, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "a zoo of specialised\nmodels, one per surface", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "rectangle", "id": "k4", "x": 884, "y": 372, "width": 248, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "image, video and music\nare separate model families", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},
  {"type": "rectangle", "id": "k5", "x": 1152, "y": 372, "width": 248, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "the model must perceive,\nplan and act", "fontSize": 16, "fontFamily": 2, "strokeColor": "#4d1d13"}},

