  {"type": "arrow", "id": "d5b", "x": 1276, "y": 444, "width": 0, "height": 40, "points": [[0, 0], [0, 40]], "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0},

  {"type": "rectangle", "id": "r1", "x": 80, "y": 486, "width": 248, "height": 124, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "TOKENIZE IT\ncut speech into discrete\naudio tokens: TTS becomes\nlanguage modelling", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r2", "x": 348, "y": 486, "width": 248, "height": 124, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "STREAM IT\nvoice the first audio\npackets at once: latency\nlives in the architecture", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r3", "x": 616, "y": 486, "width": 248, "height": 124, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "CONSOLIDATE IT\none foundation model for\nevery surface, at a scale\n\"bigger than search\"", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r4", "x": 884, "y": 486, "width": 248, "height": 124, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "COMPOSE IT\nGemini writes the prompts;\nImagen, Veo and Lyria\nmake the media", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "r5", "x": 1152, "y": 486, "width": 248, "height": 124, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "CONSOLIDATE IT\none end-to-end model:\nWaymo's EMMA drives,\nGR00T N1 moves a humanoid", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "text", "id": "r4_n", "x": 894, "y": 616, "text": "the exception: compose, don't merge", "fontSize": 15, "fontFamily": 2, "strokeColor": "#0f766e"},

