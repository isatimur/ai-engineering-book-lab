  {"type": "text", "id": "card_h", "x": 100, "y": 562, "text": "the same move, three companies", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4"},
  {"type": "text", "id": "card_b", "x": 100, "y": 590, "text": "YouTube   \"how can we rethink this recommendation\n           system on top of Gemini,\"\nNetflix   \"by integrating the foundation model into\n           all systems we can create high leverage.\"\nLinkedIn  \"...solve all the personalization tasks\n           that LinkedIn has with just one model.\"", "fontSize": 16, "fontFamily": 3, "strokeColor": "#ccfbf1"},
  {"type": "ellipse", "id": "claim", "x": 930, "y": 560, "width": 470, "height": 130, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "\"a bigger consumer\napplication than search\"\n(YouTube, #245)", "fontSize": 20, "fontFamily": 2, "strokeColor": "#ffffff"}},
