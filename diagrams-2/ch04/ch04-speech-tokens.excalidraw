  },
  {
   "type": "text",
   "id": "card_b",
   "x": 100,
   "y": 550,
   "text": "#663 \"We're trying to transform the problem as a\n      language modeling problem because humanity is\n      extremely good at modeling sequences of token.\"\n#385 \"...input ideally text and audio and output\n      a string of audio tokens.\"\n#663 \"as soon as you have the first audio packets,\n      you start to voice them out.\"",
   "fontSize": 16,
   "fontFamily": 3,
   "strokeColor": "#ccfbf1"
  },
  {
   "type": "ellipse",
   "id": "claim",
   "x": 910,
