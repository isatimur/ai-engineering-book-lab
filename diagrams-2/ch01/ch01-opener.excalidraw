  "elements": [
    { "type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 2 · CHAPTER 1 · THE ARGUMENT", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "title", "x": 80, "y": 68, "text": "Training and the Turn to RL", "fontSize": 36, "fontFamily": 2, "strokeColor": "#155e75" },
    { "type": "line", "id": "sig_teal", "x": 80, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0 },
    { "type": "line", "id": "sig_rose", "x": 190, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0 },
    { "type": "text", "id": "role", "x": 80, "y": 140, "text": "Six claims, one direction: behavior moves out of the prompt and into the weights.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "rectangle", "id": "from", "x": 80, "y": 210, "width": 220, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "THE PROMPT\npatch, hope, repeat", "fontSize": 17, "fontFamily": 2, "strokeColor": "#a8412e" } },
    { "type": "rectangle", "id": "to", "x": 1180, "y": 210, "width": 220, "height": 70, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "THE WEIGHTS\ntrained against a reward", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e" } },
    { "type": "arrow", "id": "band", "x": 300, "y": 245, "width": 880, "height": 0, "strokeColor": "#0f766e", "strokeWidth": 4, "roughness": 0, "start": { "id": "from" }, "end": { "id": "to" } },

    { "type": "rectangle", "id": "c1", "x": 80, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Reasoning and\nagency are one\ntraining problem", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c2", "x": 303, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "RL is the method\nthat carries a model\ninto production", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c3", "x": 526, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "Code scales RL\nfirst: tests and\ncompilers grade it", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c4", "x": 749, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "The data recipe\nbeats model size", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c5", "x": 972, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "You probably don't\nneed fine-tuning,\nuntil you do", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c6", "x": 1195, "y": 330, "width": 205, "height": 150, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "The hard part is\noperations, not\nthe algorithm", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },

