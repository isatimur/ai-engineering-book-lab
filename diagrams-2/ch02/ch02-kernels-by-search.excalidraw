{
  "type": "excalidraw-skeleton",
  "appState": { "viewBackgroundColor": "#ffffff" },
  "elements": [
    { "type": "text", "id": "eyebrow", "x": 80, "y": 40, "text": "BOOK 2 · CHAPTER 2 · HOW IT WORKS", "fontSize": 16, "fontFamily": 2, "strokeColor": "#64748b" },
    { "type": "text", "id": "title", "x": 80, "y": 68, "text": "Fast kernels, found by search instead of written by hand", "fontSize": 34, "fontFamily": 2, "strokeColor": "#155e75" },
    { "type": "line", "id": "sig_teal", "x": 80, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0 },
    { "type": "line", "id": "sig_rose", "x": 190, "y": 122, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0 },
    { "type": "text", "id": "role", "x": 80, "y": 138, "text": "A kernel is the low-level code that runs one operation on the GPU. Writing a fast one used to need a rare expert.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b" },

    { "type": "text", "id": "before_h", "x": 80, "y": 210, "text": "BEFORE", "fontSize": 16, "fontFamily": 2, "strokeColor": "#a8412e" },
    { "type": "rectangle", "id": "op0", "x": 80, "y": 240, "width": 200, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "attention op", "fontSize": 17, "fontFamily": 3, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "expert", "x": 360, "y": 240, "width": 300, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "a specialist hand-writes it", "fontSize": 17, "fontFamily": 2, "strokeColor": "#4d1d13" } },
    { "type": "arrow", "id": "b1", "x": 280, "y": 275, "width": 80, "height": 0, "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "start": { "id": "op0" }, "end": { "id": "expert" } },
    { "type": "text", "id": "before_n", "x": 690, "y": 262, "text": "the deployment waits on someone rare", "fontSize": 17, "fontFamily": 2, "strokeColor": "#a8412e" },

    { "type": "text", "id": "after_h", "x": 80, "y": 360, "text": "AFTER · SEARCH-BASED COMPILATION", "fontSize": 16, "fontFamily": 2, "strokeColor": "#0f766e" },
    { "type": "rectangle", "id": "op1", "x": 80, "y": 420, "width": 200, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "attention op", "fontSize": 17, "fontFamily": 3, "strokeColor": "#134e4a" } },
    { "type": "rectangle", "id": "c1", "x": 380, "y": 390, "width": 190, "height": 40, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": { "text": "candidate A", "fontSize": 15, "fontFamily": 3, "strokeColor": "#475569" } },
    { "type": "rectangle", "id": "c2", "x": 380, "y": 440, "width": 190, "height": 40, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": { "text": "candidate B", "fontSize": 15, "fontFamily": 3, "strokeColor": "#475569" } },
    { "type": "rectangle", "id": "c3", "x": 380, "y": 490, "width": 190, "height": 40, "backgroundColor": "#ffffff", "strokeColor": "#94a3b8", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": { "text": "candidate …", "fontSize": 15, "fontFamily": 3, "strokeColor": "#475569" } },
    { "type": "arrow", "id": "a1", "x": 280, "y": 445, "width": 100, "height": -35, "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "start": { "id": "op1" }, "end": { "id": "c1" } },
    { "type": "arrow", "id": "a2", "x": 280, "y": 455, "width": 100, "height": 5, "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "start": { "id": "op1" }, "end": { "id": "c2" } },
    { "type": "arrow", "id": "a3", "x": 280, "y": 465, "width": 100, "height": 45, "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "start": { "id": "op1" }, "end": { "id": "c3" } },
    { "type": "text", "id": "gen_l", "x": 300, "y": 545, "text": "compiler enumerates\nthe options", "fontSize": 14, "fontFamily": 2, "strokeColor": "#94a3b8" },
    { "type": "rectangle", "id": "bench", "x": 650, "y": 420, "width": 200, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "measure each", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a" } },
    { "type": "arrow", "id": "a4", "x": 570, "y": 460, "width": 80, "height": 0, "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0, "start": { "id": "c2" }, "end": { "id": "bench" } },
    { "type": "rectangle", "id": "win", "x": 930, "y": 405, "width": 260, "height": 100, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 3, "fillStyle": "solid", "roughness": 0, "label": { "text": "keep the fastest:\nflash attention", "fontSize": 19, "fontFamily": 2, "strokeColor": "#0f766e" } },
    { "type": "arrow", "id": "a5", "x": 850, "y": 455, "width": 80, "height": 0, "strokeColor": "#0f766e", "strokeWidth": 2, "roughness": 0, "start": { "id": "bench" }, "end": { "id": "win" } },

    { "type": "rectangle", "id": "card", "x": 80, "y": 610, "width": 620, "height": 120, "backgroundColor": "#0b2b2e", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0 },
    { "type": "text", "id": "card_h", "x": 100, "y": 622, "text": "what the talks report", "fontSize": 15, "fontFamily": 3, "strokeColor": "#5eead4" },
    { "type": "text", "id": "card_b", "x": 100, "y": 650, "text": "Luminal search:   \"the fastest one ... just happens\n                   to be flash attention\"\nGimlet generated: 40% speed-up over baseline on M4", "fontSize": 16, "fontFamily": 3, "strokeColor": "#ccfbf1" },

    { "type": "ellipse", "id": "claim", "x": 760, "y": 610, "width": 520, "height": 90, "backgroundColor": "#e11d48", "strokeColor": "#881337", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": { "text": "The expert layer is being automated.", "fontSize": 21, "fontFamily": 2, "strokeColor": "#ffffff" } },
    { "type": "text", "id": "cite", "x": 80, "y": 760, "text": "Sources: #388 Joe Fioti (Luminal) · #068 Natalie Serrino (Gimlet Labs)", "fontSize": 15, "fontFamily": 2, "strokeColor": "#475569" }
  ]
}
