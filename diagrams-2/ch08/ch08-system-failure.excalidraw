   "strokeColor": "#5eead4"
  },
  {
   "type": "text",
   "id": "card_b",
   "x": 100,
   "y": 730,
   "text": "Garg    -> \"the issue will look like it's the policy but it's actually the software system\"\nHadsell -> \"our approach we look for root nodes. You know we're not going to waste time on the leaves.\"\nRae     -> \"So, progress has really been marked by identifying key bottlenecks towards intelligence\n            and then solving them.\"",
   "fontSize": 15,
   "fontFamily": 3,
   "strokeColor": "#ccfbf1"
  },
