  {"type": "text", "id": "title", "x": 80, "y": 68, "text": "What the Edges Teach", "fontSize": 36, "fontFamily": 2, "strokeColor": "#155e75"},
  {"type": "line", "id": "sig_teal", "x": 80, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#0e7490", "strokeWidth": 3, "roughness": 0},
  {"type": "line", "id": "sig_rose", "x": 190, "y": 124, "width": 110, "height": 0, "points": [[0, 0], [110, 0]], "strokeColor": "#be185d", "strokeWidth": 3, "roughness": 0},
  {"type": "text", "id": "role", "x": 80, "y": 140, "text": "Two edges of one thesis: the constraints come from the domain, not from a weak model.", "fontSize": 20, "fontFamily": 2, "strokeColor": "#64748b"},

  {"type": "rectangle", "id": "p1", "x": 80, "y": 210, "width": 420, "height": 100, "backgroundColor": "#ffffff", "strokeColor": "#0e7490", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "PART I · THE MODEL LAYER\nthe line moves down:\nbehavior is trained in, not received", "fontSize": 17, "fontFamily": 2, "strokeColor": "#155e75"}},
  {"type": "rectangle", "id": "p2", "x": 80, "y": 330, "width": 420, "height": 100, "backgroundColor": "#ffffff", "strokeColor": "#be185d", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "PART II · THE LONG TAIL\nthe line moves sideways: the binding\nconstraint sits outside the model", "fontSize": 17, "fontFamily": 2, "strokeColor": "#9f1239"}},
  {"type": "arrow", "id": "a1", "x": 502, "y": 260, "width": 96, "height": 30, "points": [[0, 0], [96, 30]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0},
  {"type": "arrow", "id": "a2", "x": 502, "y": 380, "width": 96, "height": -30, "points": [[0, 0], [96, -30]], "strokeColor": "#475569", "strokeWidth": 2, "roughness": 0},

  {"type": "rectangle", "id": "teach", "x": 600, "y": 200, "width": 800, "height": 240, "backgroundColor": "#ccfbf1", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0},
  {"type": "text", "id": "teach_h", "x": 625, "y": 215, "text": "WHAT THE EDGES TEACH: THE CONSTRAINTS COME FROM THE DOMAIN", "fontSize": 17, "fontFamily": 2, "strokeColor": "#0f766e"},
  {"type": "rectangle", "id": "q1", "x": 625, "y": 255, "width": 240, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "what must be true", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "q2", "x": 885, "y": 255, "width": 240, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "who has to answer\nfor it", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "q3", "x": 1145, "y": 255, "width": 230, "height": 70, "backgroundColor": "#ffffff", "strokeColor": "#134e4a", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "what can be measured\nbefore anyone finds out", "fontSize": 16, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "notscaf", "x": 625, "y": 345, "width": 750, "height": 70, "backgroundColor": "#f5d5d0", "strokeColor": "#a8412e", "strokeWidth": 2, "strokeStyle": "dashed", "fillStyle": "solid", "roughness": 0, "label": {"text": "not scaffolding for a weak model: a better model moves work\nacross the line faster. It does not move the line.", "fontSize": 17, "fontFamily": 2, "strokeColor": "#4d1d13"}},

  {"type": "rectangle", "id": "c1", "x": 80, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "Behavior is\ntrained in, not\nprompted in", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "c2", "x": 303, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "Capability\nconsolidates into\none model", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "c3", "x": 526, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "Accountability\nstays in narrow\nlanes", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "c4", "x": 749, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "A grounding ceiling\ndisqualifies; a\nnamed human decides", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "c5", "x": 972, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "What you can\nmeasure is what\nyou can delegate", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
  {"type": "rectangle", "id": "c6", "x": 1195, "y": 500, "width": 205, "height": 130, "backgroundColor": "#ffffff", "strokeColor": "#0f766e", "strokeWidth": 2, "fillStyle": "solid", "roughness": 0, "label": {"text": "The failure is\nusually in the\nsystem", "fontSize": 17, "fontFamily": 2, "strokeColor": "#134e4a"}},
